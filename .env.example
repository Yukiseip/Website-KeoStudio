# ==============================================================================
# KÉO SALÓN-STUDIO — ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to .env.local for local development.
# Do NOT commit sensitive keys to your public git repository.

# Application URL
NEXT_PUBLIC_SITE_URL=https://keosalon.com

# WhatsApp Contact (International format without '+' or spaces, e.g., 525512345678)
NEXT_PUBLIC_WHATSAPP_PHONE=525512345678

# Resend API Key (Optional — for automated email confirmation dispatch)
# https://resend.com
RESEND_API_KEY=re_your_api_key_here

# Google Calendar API (Optional — for direct calendar synchronization)
GOOGLE_CALENDAR_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_CALENDAR_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."
GOOGLE_CALENDAR_ID=primary

